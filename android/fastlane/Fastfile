# Fastfile for Android deployment
# This file contains all the lanes for building and deploying the Android app

default_platform(:android)

platform :android do
  desc "Build a debug APK"
  lane :build_debug do
    gradle(
      task: "assemble",
      build_type: "Debug",
      project_dir: "./"
    )
  end

  desc "Build a release APK"
  lane :release do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "./"
    )
  end

  desc "Build and upload a beta AAB to Google Play Internal Testing"
  lane :beta do
    # Build Flutter app bundle
    Dir.chdir("..") do
      sh("flutter", "build", "appbundle", "--release")
    end
    
    # Debug: Find all AAB files in the build directory
    UI.important("=== Searching for AAB files ===")
    aab_files = Dir.glob("../**/*.aab") + Dir.glob("**/*.aab")
    UI.important("Found #{aab_files.length} AAB files:")
    aab_files.each { |file| UI.important("  - #{file}") }
    
    UI.important("=== Listing all build output directories ===")
    Dir.glob("../build/**/outputs/**/*").select { |f| File.directory?(f) }.each { |dir| UI.important("  Directory: #{dir}") }
    Dir.glob("build/**/outputs/**/*").select { |f| File.directory?(f) }.each { |dir| UI.important("  Directory: #{dir}") }
    Dir.glob("app/build/outputs/**/*").select { |f| File.directory?(f) }.each { |dir| UI.important("  Directory: #{dir}") }
    
    UI.important("=== Listing all files in build directory ===")
    Dir.glob("../build/**/*").select { |f| File.file?(f) }.each { |file| UI.important("  - #{file}") }
    Dir.glob("build/**/*").select { |f| File.file?(f) }.each { |file| UI.important("  - #{file}") }
    Dir.glob("app/build/**/*").select { |f| File.file?(f) }.each { |file| UI.important("  - #{file}") }
    
    UI.important("=== Searching for any bundle files ===")
    bundle_files = Dir.glob("../**/*bundle*") + Dir.glob("**/*bundle*")
    UI.important("Found #{bundle_files.length} bundle files:")
    bundle_files.each { |file| UI.important("  - #{file}") }
    
    # Try to find the AAB file in multiple possible locations (Flutter generates in ../build/app/outputs/)
    aab_path = Dir.glob("../build/app/outputs/bundle/release/*.aab").first ||
               Dir.glob("build/app/outputs/bundle/release/*.aab").first ||
               Dir.glob("app/build/outputs/bundle/release/*.aab").first ||
               Dir.glob("**/outputs/bundle/release/*.aab").first ||
               Dir.glob("**/*.aab").first
    
    if aab_path.nil?
      UI.error("Could not find any AAB file in expected locations")
      UI.error("Available AAB files:")
      aab_files.each { |file| UI.error("  - #{file}") }
      raise "No AAB file found"
    end
    
    UI.success("Found AAB file: #{aab_path}")
    
    # Upload to Google Play Internal Testing
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Deploy a new version to Google Play Production"
  lane :deploy do
    # Build Flutter app bundle
    Dir.chdir("..") do
      sh("flutter", "build", "appbundle", "--release")
    end
    
    # Debug: Find all AAB files in the build directory
    UI.important("=== Searching for AAB files ===")
    aab_files = Dir.glob("**/*.aab")
    UI.important("Found #{aab_files.length} AAB files:")
    aab_files.each { |file| UI.important("  - #{file}") }
    
    # Try to find the AAB file
    aab_path = Dir.glob("app/build/outputs/bundle/release/*.aab").first
    
    if aab_path.nil?
      UI.error("Could not find any AAB file in app/build/outputs/bundle/release/")
      UI.error("Available AAB files:")
      aab_files.each { |file| UI.error("  - #{file}") }
      raise "No AAB file found"
    end
    
    UI.success("Found AAB file: #{aab_path}")
    
    # Upload to Google Play Production
    upload_to_play_store(
      track: "production",
      aab: aab_path,
      release_status: "completed",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Deploy to Google Play Alpha track"
  lane :alpha do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./"
    )
    
    # Debug: Find all AAB files in the build directory
    UI.important("=== Searching for AAB files ===")
    aab_files = Dir.glob("**/*.aab")
    UI.important("Found #{aab_files.length} AAB files:")
    aab_files.each { |file| UI.important("  - #{file}") }
    
    # Try to find the AAB file
    aab_path = Dir.glob("app/build/outputs/bundle/release/*.aab").first
    
    if aab_path.nil?
      UI.error("Could not find any AAB file in app/build/outputs/bundle/release/")
      UI.error("Available AAB files:")
      aab_files.each { |file| UI.error("  - #{file}") }
      raise "No AAB file found"
    end
    
    UI.success("Found AAB file: #{aab_path}")
    
    upload_to_play_store(
      track: "alpha",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Deploy to Google Play Beta track"
  lane :beta_track do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./"
    )
    
    # Debug: Find all AAB files in the build directory
    UI.important("=== Searching for AAB files ===")
    aab_files = Dir.glob("**/*.aab")
    UI.important("Found #{aab_files.length} AAB files:")
    aab_files.each { |file| UI.important("  - #{file}") }
    
    # Try to find the AAB file
    aab_path = Dir.glob("app/build/outputs/bundle/release/*.aab").first
    
    if aab_path.nil?
      UI.error("Could not find any AAB file in app/build/outputs/bundle/release/")
      UI.error("Available AAB files:")
      aab_files.each { |file| UI.error("  - #{file}") }
      raise "No AAB file found"
    end
    
    UI.success("Found AAB file: #{aab_path}")
    
    upload_to_play_store(
      track: "beta",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Upload metadata to Google Play Store"
  lane :upload_metadata do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Run unit tests"
  lane :test do
    gradle(
      task: "test",
      project_dir: "./"
    )
  end

  desc "Build APK for distribution"
  lane :build_apk do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "./"
    )
  end

  desc "Build App Bundle for distribution"
  lane :build_bundle do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./"
    )
  end

  desc "Supply screenshots to Google Play Store"
  lane :screenshots do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      json_key: "./google-play-service-account.json"
    )
  end

  # Error block
  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")
  end
end
