# Fastfile for Android deployment
# This file contains all the lanes for building and deploying the Android app

default_platform(:android)

PACKAGE_NAME = "com.thegreenmall"
PLAY_JSON_KEY = "./google-play-service-account.json"

platform :android do
  # Highest version code currently on Google Play across all tracks. The AAB's
  # versionCode is baked in from pubspec.yaml at flutter-build time and drifts
  # out of sync, causing "Version code N has already been used". We compute the
  # next code from Play and export it to GITHUB_ENV so the build step can pass
  # it to `flutter build --build-number`, guaranteeing a strictly higher code.
  lane :set_version_code do
    codes = []
    %w[internal alpha beta production].each do |track|
      begin
        codes.concat(Array(google_play_track_version_codes(
          package_name: PACKAGE_NAME,
          track: track,
          json_key: PLAY_JSON_KEY
        )))
      rescue => e
        UI.important("Could not read version codes for track '#{track}': #{e.message}")
      end
    end
    next_code = (codes.compact.max || 0) + 1
    UI.success("Next Android version code: #{next_code}")
    File.open(ENV['GITHUB_ENV'], 'a') { |f| f.puts("ANDROID_VERSION_CODE=#{next_code}") } if ENV['GITHUB_ENV']
  end

  # Locate the AAB produced by `flutter build appbundle` (always emitted to the
  # Flutter project root, not the android/ dir).
  def find_aab
    path = Dir.glob(File.join(File.expand_path("../.."), "build/app/outputs/bundle/release/*.aab")).first
    UI.user_error!("No AAB found at build/app/outputs/bundle/release/*.aab") if path.nil?
    UI.success("Found AAB file: #{path}")
    path
  end

  desc "Build a debug APK"
  lane :build_debug do
    gradle(
      task: "assemble",
      build_type: "Debug",
      project_dir: "./"
    )
  end

  desc "Build a release APK"
  lane :release do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "./"
    )
  end

  desc "Upload a pre-built beta AAB to Google Play Internal Testing"
  lane :beta do
    # The AAB is built in the CI pipeline (with a Play-derived versionCode) before this step.
    upload_to_play_store(
      track: 'internal',
      aab: find_aab,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: PLAY_JSON_KEY,
      release_status: 'draft'
    )
  end

  desc "Increment version code only (for manual version bump)"
  lane :increment_version_code_only do
    # Get project root directory
    project_root = File.expand_path("../..")
    pubspec_path = File.join(project_root, "pubspec.yaml")

    # Read current pubspec.yaml
    pubspec_content = File.read(pubspec_path)

    # Extract current version code
    version_line = pubspec_content.match(/^version:\s*\d+\.\d+\.\d+\+(\d+)/)
    if version_line.nil?
      UI.error("Could not find version line in pubspec.yaml")
      return
    end

    current_version_code = version_line[1].to_i
    new_version_code = current_version_code + 1

    # Extract version name
    version_name_match = pubspec_content.match(/^version:\s*(\d+\.\d+\.\d+)/)
    version_name = version_name_match ? version_name_match[1] : "1.0.0"

    # Update version line
    new_version_line = "version: #{version_name}+#{new_version_code}"
    updated_content = pubspec_content.sub(/^version:\s*\d+\.\d+\.\d+\+\d+/, new_version_line)

    # Write back to pubspec.yaml
    File.write(pubspec_path, updated_content)

    UI.success("Version code incremented from #{current_version_code} to #{new_version_code}")
    UI.success("New version: #{version_name}+#{new_version_code}")
  end

  desc "Bump major version (e.g., 1.0.0+1 -> 2.0.0+1)"
  lane :bump_major_version do
    # Get project root directory
    project_root = File.expand_path("../..")
    pubspec_path = File.join(project_root, "pubspec.yaml")

    # Read current pubspec.yaml
    pubspec_content = File.read(pubspec_path)

    # Extract current version
    version_line = pubspec_content.match(/^version:\s*(\d+)\.(\d+)\.(\d+)\+(\d+)/)
    if version_line.nil?
      UI.error("Could not find version line in pubspec.yaml")
      return
    end

    major = version_line[1].to_i
    minor = version_line[2].to_i
    patch = version_line[3].to_i
    build = version_line[4].to_i

    # Bump major version, reset minor and patch to 0, keep build as 1
    new_major = major + 1
    new_minor = 0
    new_patch = 0
    new_build = 1

    # Update version line
    new_version_line = "version: #{new_major}.#{new_minor}.#{new_patch}+#{new_build}"
    updated_content = pubspec_content.sub(/^version:\s*\d+\.\d+\.\d+\+\d+/, new_version_line)

    # Write back to pubspec.yaml
    File.write(pubspec_path, updated_content)

    UI.success("Version bumped from #{major}.#{minor}.#{patch}+#{build} to #{new_major}.#{new_minor}.#{new_patch}+#{new_build}")
  end

  desc "Bump minor version (e.g., 1.0.0+1 -> 1.1.0+1)"
  lane :bump_minor_version do
    # Get project root directory
    project_root = File.expand_path("../..")
    pubspec_path = File.join(project_root, "pubspec.yaml")

    # Read current pubspec.yaml
    pubspec_content = File.read(pubspec_path)

    # Extract current version
    version_line = pubspec_content.match(/^version:\s*(\d+)\.(\d+)\.(\d+)\+(\d+)/)
    if version_line.nil?
      UI.error("Could not find version line in pubspec.yaml")
      return
    end

    major = version_line[1].to_i
    minor = version_line[2].to_i
    patch = version_line[3].to_i
    build = version_line[4].to_i

    # Bump minor version, reset patch to 0, keep build as 1
    new_major = major
    new_minor = minor + 1
    new_patch = 0
    new_build = 1

    # Update version line
    new_version_line = "version: #{new_major}.#{new_minor}.#{new_patch}+#{new_build}"
    updated_content = pubspec_content.sub(/^version:\s*\d+\.\d+\.\d+\+\d+/, new_version_line)

    # Write back to pubspec.yaml
    File.write(pubspec_path, updated_content)

    UI.success("Version bumped from #{major}.#{minor}.#{patch}+#{build} to #{new_major}.#{new_minor}.#{new_patch}+#{new_build}")
  end

  desc "Bump patch version (e.g., 1.0.0+1 -> 1.0.1+1)"
  lane :bump_patch_version do
    # Get project root directory
    project_root = File.expand_path("../..")
    pubspec_path = File.join(project_root, "pubspec.yaml")

    # Read current pubspec.yaml
    pubspec_content = File.read(pubspec_path)

    # Extract current version
    version_line = pubspec_content.match(/^version:\s*(\d+)\.(\d+)\.(\d+)\+(\d+)/)
    if version_line.nil?
      UI.error("Could not find version line in pubspec.yaml")
      return
    end

    major = version_line[1].to_i
    minor = version_line[2].to_i
    patch = version_line[3].to_i
    build = version_line[4].to_i

    # Bump patch version, keep build as 1
    new_major = major
    new_minor = minor
    new_patch = patch + 1
    new_build = 1

    # Update version line
    new_version_line = "version: #{new_major}.#{new_minor}.#{new_patch}+#{new_build}"
    updated_content = pubspec_content.sub(/^version:\s*\d+\.\d+\.\d+\+\d+/, new_version_line)

    # Write back to pubspec.yaml
    File.write(pubspec_path, updated_content)

    UI.success("Version bumped from #{major}.#{minor}.#{patch}+#{build} to #{new_major}.#{new_minor}.#{new_patch}+#{new_build}")
  end

  desc "Deploy a new version to Google Play Production"
  lane :deploy do
    # The AAB is built in the CI pipeline (with a Play-derived versionCode) before this step.
    upload_to_play_store(
      track: "internal",
      aab: find_aab,
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: PLAY_JSON_KEY
    )
  end

  desc "Deploy to Google Play Alpha track"
  lane :alpha do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./"
    )
    
    # Debug: Find all AAB files in the build directory
    UI.important("=== Searching for AAB files ===")
    aab_files = Dir.glob("**/*.aab")
    UI.important("Found #{aab_files.length} AAB files:")
    aab_files.each { |file| UI.important("  - #{file}") }
    
    # Try to find the AAB file
    aab_path = Dir.glob("app/build/outputs/bundle/release/*.aab").first ||
               Dir.glob("**/*.aab").first
    
    if aab_path.nil?
      UI.error("Could not find any AAB file in app/build/outputs/bundle/release/")
      UI.error("Available AAB files:")
      aab_files.each { |file| UI.error("  - #{file}") }
      raise "No AAB file found"
    end
    
    UI.success("Found AAB file: #{aab_path}")
    
    upload_to_play_store(
      track: "alpha",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Deploy to Google Play Beta track"
  lane :beta_track do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./"
    )
    
    # Debug: Find all AAB files in the build directory
    UI.important("=== Searching for AAB files ===")
    aab_files = Dir.glob("**/*.aab")
    UI.important("Found #{aab_files.length} AAB files:")
    aab_files.each { |file| UI.important("  - #{file}") }
    
    # Try to find the AAB file
    aab_path = Dir.glob("app/build/outputs/bundle/release/*.aab").first ||
               Dir.glob("**/*.aab").first
    
    if aab_path.nil?
      UI.error("Could not find any AAB file in app/build/outputs/bundle/release/")
      UI.error("Available AAB files:")
      aab_files.each { |file| UI.error("  - #{file}") }
      raise "No AAB file found"
    end
    
    UI.success("Found AAB file: #{aab_path}")
    
    upload_to_play_store(
      track: "beta",
      aab: aab_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Upload metadata to Google Play Store"
  lane :upload_metadata do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      json_key: "./google-play-service-account.json"
    )
  end

  desc "Run unit tests"
  lane :test do
    gradle(
      task: "test",
      project_dir: "./"
    )
  end

  desc "Build APK for distribution"
  lane :build_apk do
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "./"
    )
  end

  desc "Build App Bundle for distribution"
  lane :build_bundle do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "./"
    )
  end

  desc "Supply screenshots to Google Play Store"
  lane :screenshots do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      json_key: "./google-play-service-account.json"
    )
  end

  # Error block
  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")
  end
end
