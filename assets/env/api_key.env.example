# Base URL for the backend API without the /api/v1/ suffix
BASE_URL_WO_API=https://your-api-url.com/

# API version identifier
VERSION=v1

# Google Maps API key for map and geocoding functionality
GOOGLE_MAP_KEY=your-google-maps-api-key

# Stripe API endpoint for creating payment tokens
STRIPE_API_URL=https://api.stripe.com/v1/tokens

# Stripe Basic auth token for card-related operations
STRIPE_CARD_BASIC_AUTH=your-stripe-card-basic-auth

# Stripe Basic auth token for bank account operations
STRIPE_BANK_BASIC_AUTH=your-stripe-bank-basic-auth

# Stripe publishable key for client-side payment operations (Google Pay, Apple Pay)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
